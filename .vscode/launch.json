{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch (Cross-Platform)",
            // Domyślny debuger dla Linux / macOS (wymaga CodeLLDB lub wbudowanego lldb)
            "type": "lldb", 
            "request": "launch",
            "program": "${workspaceFolder}/build-${input:buildType}/bin/test",
            "cwd": "${workspaceFolder}/build-${input:buildType}/bin",
            "console": "integratedTerminal",
            
            // --- NACPISANIE DLA WINDOWS ---
            "windows": {
                "type": "cppvsdbg",
                "program": "${workspaceFolder}\\build-${input:buildType}\\bin\\test.exe",
                "cwd": "${workspaceFolder}\\build-${input:buildType}\\bin"
            },
            
            // "preLaunchTask": "CMake: build"
        }
    ],
    "inputs": [
        {
            "id": "buildType",
            "type": "pickString",
            "description": "Select configuration:",
            "options": ["Debug", "Release"],
            "default": "Debug"
        }
    ]
}
