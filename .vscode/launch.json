{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Application",
            "type": "lldb", 
            "request": "launch",
            "program": "${workspaceFolder}/build-Debug/bin/${input:targetApp}",
            "cwd": "${workspaceFolder}/build-Debug/bin",
            "console": "integratedTerminal",
            
            // --- WINDOWS OVERRIDE ---
            "windows": {
                "type": "cppvsdbg",
                "program": "${workspaceFolder}\\build-Debug\\bin\\${input:targetApp}.exe",
                "cwd": "${workspaceFolder}\\build-Debug\\bin"
            },
            
            "preLaunchTask": "CMake: build"
        }
    ],
    "inputs": [
        {
            "id": "targetApp",
            "type": "pickString",
            "description": "Select application to launch:",
            "options": [
                {
                    "label": "editor",
                    "value": "editor"
                },
                {
                    "label": "tests",
                    "value": "test"
                }
            ],
            "default": "editor"
        }
    ]
}